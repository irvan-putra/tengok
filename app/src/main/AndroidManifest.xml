<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- tengok asks for no permissions at all. Files arrive through the
         system picker or from other apps, and never leave the phone. -->

    <!-- Media3 library manifests add these, but tengok only ever plays
         local files and never touches the network or asks to stay awake,
         so they are stripped to keep the app at zero permissions. Each
         removal names the library that contributes it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <!-- Optional hardware: game mode can hear a USB MIDI keyboard through
         the system MIDI service. Not required - nothing else changes, and
         phones without MIDI support keep every other feature. Neither
         feature needs a runtime permission. -->
    <uses-feature android:name="android.software.midi" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:label="tengok"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/TengokTheme"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity android:name=".ViewerActivity" android:exported="false" />
        <activity android:name=".ExplorerActivity" android:exported="false" />
    </application>
</manifest>
